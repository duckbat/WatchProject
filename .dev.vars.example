# Copy to .dev.vars (never committed) and restart `npm run dev`.
# Marketplace keys are optional; each one switches on a live source on watch pages.

# eBay Browse API (free developer account) — see MARKETPLACES.md
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Marketplace to search: EBAY_DE, EBAY_US, EBAY_GB, EBAY_FR, EBAY_IT or EBAY_ES
EBAY_MARKETPLACE=EBAY_DE
# production (default) or sandbox. Sandbox only checks the connection; its test listings are never used as prices.
EBAY_ENVIRONMENT=production
EBAY_SANDBOX_CLIENT_ID=
EBAY_SANDBOX_CLIENT_SECRET=
# Marketplace Account Deletion (needed once to enable a new production keyset): the public HTTPS URL of
# /api/ebay/account-deletion, exactly as entered on developer.ebay.com, and a 32-80 character token (letters, digits, _ -).
EBAY_DELETION_ENDPOINT=
EBAY_VERIFICATION_TOKEN=

# Optional: Reddit API app. Without it, r/Watchexchange posts arrive via WatchRecon (Reddit's RSS feed is closed).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
